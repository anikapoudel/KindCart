class SearchScreen extends StatefulWidget {
  const SearchScreen({super.key});

  @override
  State<SearchScreen> createState() => _SearchScreenState();
}

class _SearchScreenState extends State<SearchScreen>
    with SingleTickerProviderStateMixin {
  final TextEditingController _searchController = TextEditingController();
  final FocusNode _focusNode = FocusNode();

  final List<String> _recentSearches = [];
  String _selectedCategory = 'All';
  bool _isSearching = false;
  bool _isInitialLoad = true;
  List<ProductModel> _searchResults = [];

  late AnimationController _animationController;
  late Animation<double> _fadeAnimation;

  @override
  void initState() {
    super.initState();

    _animationController = AnimationController(
      duration: const Duration(milliseconds: 500),
      vsync: this,
    );
    _fadeAnimation = CurvedAnimation(
      parent: _animationController,
      curve: Curves.easeIn,
    );

    WidgetsBinding.instance.addPostFrameCallback((_) {
      _performSearch('');
      _animationController.forward();
    });
  }

  @override
  void dispose() {
    _searchController.dispose();
    _focusNode.dispose();
    _animationController.dispose();
    super.dispose();
  }

  bool isWebPlatform() {
    return identical(0, 0.0) ? true : false;
  }

  void _saveSearch(String query) {
    if (query.trim().isEmpty) return;
    if (!_recentSearches.contains(query)) {
      setState(() {
        _recentSearches.insert(0, query);
        if (_recentSearches.length > 8) _recentSearches.removeLast();
      });
    }
  }

  void _performSearch(String query) {
    if (!_isInitialLoad) {
      setState(() => _isSearching = true);
    }

    try {
      final productProvider =
          Provider.of<ProductProvider>(context, listen: false);

      final results = productProvider.products.where((product) {
        if (!product.isAvailable) return false;

        if (_selectedCategory == 'All') {
          if (query.trim().isEmpty) {
            return true;
          }
          return product.title.toLowerCase().contains(query.toLowerCase()) ||
              product.description.toLowerCase().contains(query.toLowerCase());
        }

        final matchesQuery = query.trim().isEmpty
            ? true
            : product.title.toLowerCase().contains(query.toLowerCase()) ||
                product.description.toLowerCase().contains(query.toLowerCase());

        final matchesCategory = product.category == _selectedCategory;

        return matchesQuery && matchesCategory;
      }).toList();

      setState(() {
        _searchResults = results;
        _isSearching = false;
        _isInitialLoad = false;
      });

      if (results.isNotEmpty && query.trim().isNotEmpty) _saveSearch(query);
    } catch (e) {
      debugPrint('Search error: $e');
      setState(() {
        _isSearching = false;
        _isInitialLoad = false;
      });
    }
  }

  void _clearSearch() {
    _searchController.clear();
    _performSearch('');
  }

