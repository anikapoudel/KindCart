  void _prefillUserData() {
    debugPrint('🔄 Pre-filling user data');
    try {
      final authProvider =
          Provider.of<app_auth.AuthProvider>(context, listen: false);
      final user = authProvider.user;
      final userData = authProvider.userData;

      if (user != null) {
        _nameController.text = userData?['name'] ?? user.displayName ?? '';
        _phoneController.text = userData?['phone'] ?? '';
        debugPrint(
            '✅ User data pre-filled: ${_nameController.text}, ${_phoneController.text}');
      }
    } catch (e) {
      debugPrint('❌ Error pre-filling user data: $e');
    }
  }

  @override
  void dispose() {
    debugPrint('🔄 CheckoutScreen dispose');
    _nameController.dispose();
    _phoneController.dispose();
    _addressController.dispose();
    _cityController.dispose();
    _postalCodeController.dispose();
    super.dispose();
  }

  // Helper method to safely parse price from any format
  double _parsePrice(dynamic priceValue) {
    if (priceValue == null) return 0.0;

    try {
      // If it's already a number
      if (priceValue is num) {
        return priceValue.toDouble();
      }

      // If it's a string
      if (priceValue is String) {
        String cleaned = priceValue
            .replaceAll('NPR', '')
            .replaceAll('NPR', '')
            .replaceAll('Rs', '')
            .replaceAll(',', '')
            .trim();

        // Handle empty string
        if (cleaned.isEmpty) return 0.0;

        return double.parse(cleaned);
      }

      return 0.0;
    } catch (e) {
      debugPrint('❌ Error parsing price "$priceValue": $e');
      return 0.0;
    }
  }

